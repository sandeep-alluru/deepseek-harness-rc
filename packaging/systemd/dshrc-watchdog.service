[Unit]
Description=dshrc health watchdog — restart the daemon if it stops answering

[Service]
Type=oneshot
# Absolute path: a user timer inherits almost no environment. Not templated by
# install.sh (this unit is opt-in, not part of the main install flow) — edit
# the path below to point at YOUR clone of this repo before enabling it.
ExecStart=%h/deepseek-harness-rc/tools/watchdog.sh
