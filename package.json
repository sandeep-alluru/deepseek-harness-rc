{
  "name": "dshrc",
  "version": "0.1.0",
  "description": "Remote control for DeepSeek Harness — drive your dsh coding agent from your phone over ACP (via deepseek-acp), not a screen scrape.",
  "type": "module",
  "license": "MIT",
  "author": "Sandeep Alluru",
  "homepage": "https://github.com/sandeep-alluru/deepseek-harness-rc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandeep-alluru/deepseek-harness-rc.git"
  },
  "bugs": {
    "url": "https://github.com/sandeep-alluru/deepseek-harness-rc/issues"
  },
  "keywords": [
    "acp",
    "agent",
    "agent-client-protocol",
    "ai-agent",
    "cli",
    "coding-agent",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "mobile",
    "pwa",
    "remote-control",
    "self-hosted",
    "web-push"
  ],
  "bin": {
    "dshrc": "./dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "web",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "dev": "tsx src/cli.ts",
    "test": "npm run test:suite && npm run build && npm run test:real",
    "test:unit": "node --test --experimental-strip-types test/events.test.ts test/observer.test.ts test/preflight.test.ts test/push.test.ts test/relay.test.ts test/server.test.ts",
    "test:suite": "node tools/isolated-test.mjs --test --experimental-strip-types --test-concurrency=1 test/*.test.ts",
    "test:mock": "npm run test:suite",
    "test:real": "node tools/isolated-test.mjs tools/live-ui-check.mjs && node tools/isolated-test.mjs tools/resume-check.mjs && node tools/isolated-test.mjs tools/midturn-check.mjs && node tools/isolated-test.mjs tools/acp-conformance.mjs",
    "check:approval": "node tools/isolated-test.mjs tools/e2e-drive.mjs",
    "verify:guards": "node tools/verify-guards.mjs",
    "guards": "node tools/verify-guards.mjs --list",
    "check:live": "node --experimental-strip-types tools/live-check.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "probe": "node tools/acp-probe.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,test,tools,web}/**/*.{ts,js,mjs}\" \"*.{json,js}\"",
    "format:check": "prettier --check \"{src,test,tools,web}/**/*.{ts,js,mjs}\" \"*.{json,js}\"",
    "check:stranger": "node tools/stranger-check.mjs",
    "backlog": "node tools/backlog-report.mjs",
    "check:acp": "node --experimental-strip-types tools/acp-conformance.mjs",
    "pin:acp": "node --experimental-strip-types tools/acp-conformance.mjs --pin",
    "shots": "DSHRC_SHOTS=1 node tools/isolated-test.mjs --test --experimental-strip-types --test-concurrency=1 test/browser.test.ts"
  },
  "dependencies": {
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0"
  }
}
